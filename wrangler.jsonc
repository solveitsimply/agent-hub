{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-hub",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-02",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/health"]},
  "d1_databases": [{"binding": "DB", "database_name": "agent-hub", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["17 3 * * *"]},
  "observability": {"enabled": false}
}
